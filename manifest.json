{
  "manifest_version": 2,
  "name": "Zotero MCP",
  "version": "0.1.0",
  "description": "MCP server inside Zotero for agents (search, cite, edit, collections, lookups, duplicates, Better BibTeX) plus folder export and sync of attachment files.",
  "author": "Christoph Schmidt",
  "homepage_url": "https://github.com/agentsmith29/Zotero-MCP-Plugin",
  "icons": {
    "48": "content/icons/icon.svg",
    "96": "content/icons/icon.svg"
  },
  "applications": {
    "zotero": {
      "id": "zotero-mcp@agentsmith29.github.io",
      "update_url": "https://raw.githubusercontent.com/agentsmith29/Zotero-MCP-Plugin/main/updates.json",
      "strict_min_version": "10.0",
      "strict_max_version": "10.0.*"
    }
  }
}
